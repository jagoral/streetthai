{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "jsPlugins": ["@streetthai/config/oxlint-plugin"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "eslint/no-throw-literal": "error",
    "eslint/prefer-promise-reject-errors": "error",
    "eslint/preserve-caught-error": "error",
    "unicorn/custom-error-definition": "error",
    "unicorn/throw-new-error": "error",
    "streetthai/no-bare-error": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/warn-todo": "error",
    "eslint/no-restricted-properties": [
      "error",
      {
        "object": "page",
        "property": "waitForTimeout",
        "message": "Wait for a condition, never a fixed timeout."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**", "tests/**", "e2e/**", "tools/**"],
      "rules": {
        "streetthai/no-bare-error": "off"
      }
    },
    {
      "files": ["e2e/**"],
      "rules": {
        "eslint/no-restricted-properties": [
          "error",
          {
            "object": "page",
            "property": "waitForTimeout",
            "message": "Wait for a condition, never a fixed timeout."
          },
          {
            "property": "only",
            "message": "Playwright specs never focus, skip or defer a test."
          },
          {
            "property": "skip",
            "message": "Playwright specs never focus, skip or defer a test."
          },
          {
            "property": "fixme",
            "message": "Playwright specs never focus, skip or defer a test."
          },
          {
            "property": "todo",
            "message": "Playwright specs never focus, skip or defer a test."
          }
        ]
      }
    }
  ]
}
