{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["oxfmt.config.ts", "packages/config/*.json"],
  "tasks": {
    "//#typecheck": {},
    "//#lint": {},
    "//#fmt:check": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**"]
    },
    "fmt:check": {},
    "fmt": {
      "cache": false
    },
    "//#test:node": {
      "dependsOn": ["@streetthai/web#build"],
      "cache": false
    },
    "//#test:browser": {
      "cache": false
    }
  }
}
